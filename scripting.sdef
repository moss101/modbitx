<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/DTDs/sdef.dtd">
<!-- Modbitx's scripting dictionary. It takes effect when the app is packaged
     with this sdef and NSAppleScriptEnabled in its Info.plist. -->
<dictionary title="Modbitx">
  <suite name="Standard Suite" code="core" description="Common classes and commands.">
    <class name="application" code="capp" description="Modbitx's top-level scripting object.">
      <cocoa class="NSApplication"/>
      <element type="window"/>
      <property name="name" code="pnam" type="text" access="r"/>
      <property name="frontmost" code="pisf" type="boolean" access="r"/>
      <property name="version" code="vers" type="text" access="r"/>
      <responds-to name="open">
        <cocoa method="handleOpenScriptCommand:"/>
      </responds-to>
      <responds-to name="quit">
        <cocoa method="handleQuitScriptCommand:"/>
      </responds-to>
    </class>
    <class name="window" code="cwin" description="A Modbitx window.">
      <cocoa class="NSWindow"/>
      <property name="name" code="pnam" type="text" access="r"/>
      <property name="id" code="ID  " type="integer" access="r"/>
    </class>
    <command name="open" code="aevtodoc" description="Open a chat.">
      <direct-parameter type="text" description="The chat title or id to open."/>
    </command>
  </suite>
</dictionary>
