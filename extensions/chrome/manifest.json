{
  "manifest_version": 3,
  "name": "Modbitx",
  "version": "0.1.0",
  "description": "Lets Modbitx read and act on the page you are viewing, after you allow it.",
  "permissions": ["alarms", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4737/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Modbitx" }
}
